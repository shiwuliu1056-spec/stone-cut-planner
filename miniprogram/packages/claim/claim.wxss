page{background:#f7f5f0;color:#20332f;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}button::after{border:0}button{font-size:28rpx;line-height:1.5} .shell{padding:32rpx 28rpx 180rpx}.card{background:white;border:1rpx solid rgba(23,62,56,.08);border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 12rpx 32rpx rgba(23,62,56,.04)}.title{font-size:38rpx;font-weight:700;color:#173e38}.subtitle,.muted{font-size:24rpx;color:#7b8883;line-height:1.6}.primary{background:#173e38;color:white;border-radius:16rpx;padding:20rpx 24rpx;font-weight:600}.secondary{background:#f0f4f1;color:#173e38;border-radius:16rpx;padding:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1;margin:0}.badge{color:#a17237;background:#fcf3e6;border-radius:10rpx;padding:6rpx 12rpx;font-size:22rpx}.note{color:#63776d;background:#eef3ef;padding:20rpx;border-radius:16rpx;font-size:24rpx;line-height:1.65;margin:20rpx 0}.error{color:#a8392f}.footer{position:fixed;bottom:0;left:0;right:0;background:#f7f5f0;border-top:1rpx solid #e1e7e2;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx;z-index:20}.footer button{flex:1;margin:0}.empty{padding:28rpx;text-align:center;color:#7b8883}
.row>button{flex:none;margin-left:auto;margin-right:0}
