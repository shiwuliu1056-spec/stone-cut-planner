.nav{position:fixed;top:0;left:0;right:0;background:#173e38;color:#fff;z-index:100}.nav-row{display:flex;align-items:center;position:relative}.home-button{display:flex;align-items:center;justify-content:center;margin-left:12px;width:38px;height:32px;border-radius:16px;background:rgba(255,255,255,.12)}.home-button image{width:22px;height:22px}.nav-title{position:absolute;left:50%;transform:translateX(-50%);max-width:calc(100vw - 200px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:30rpx;font-weight:600}
