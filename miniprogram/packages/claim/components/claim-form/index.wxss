.heading{margin:8rpx 0 28rpx}.field{margin:24rpx 0}.label{font-weight:600;font-size:28rpx}.required{color:#a17237;font-size:22rpx}.control{display:block;box-sizing:border-box;width:100%;background:#f8faf8;border:1rpx solid #dce5df;border-radius:14rpx;padding:20rpx;margin-top:12rpx;min-height:86rpx;font-size:28rpx;line-height:1.6}.textarea{min-height:130rpx}.ground{display:flex;align-items:flex-start;line-height:1.6;margin:22rpx 0;font-size:26rpx}.ground checkbox{transform:scale(.8);margin-left:-8rpx}.group-heading{margin:30rpx 0 22rpx}.number{font-size:38rpx;font-weight:700;color:#c99352}.upload{border:2rpx dashed #9aafa1;border-radius:16rpx;background:#f2f6f2;color:#173e38;padding:22rpx;margin:20rpx 0 14rpx}.file-row{display:flex;justify-content:space-between;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #eef1ed;align-items:center;font-size:24rpx}.filename{flex:1;overflow-wrap:anywhere}.delete{color:#a8392f;background:transparent;margin:0;font-size:24rpx}.link{color:#a17237;font-size:24rpx}.issue{padding:24rpx 0;border-bottom:1rpx solid #edf0ec;line-height:1.6}.issue.danger{color:#a8392f}.issue.info{color:#173e38}.result-link{margin-top:20rpx}
.control.row{display:flex}.template-note{box-sizing:border-box;margin:16rpx 0 24rpx;padding:20rpx;border-radius:16rpx;background:#eef3ef;line-height:1.6}.template-note .muted{margin-top:14rpx}
.heading-status{text-align:right;white-space:nowrap}.heading-status>view+view{margin-top:4rpx}
.review-section-head{margin-bottom:20rpx}.review-section-title{position:relative;padding-left:20rpx;color:#173e38;font-size:36rpx;font-weight:700;line-height:1.4}.review-section-title::before{content:"";position:absolute;left:0;top:8rpx;bottom:8rpx;width:6rpx;border-radius:3rpx;background:#c99352}
.review-group{margin-top:24rpx}.review-group-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 20rpx;border-radius:14rpx;background:#eef3ef}.review-group-name{display:flex;align-items:center;gap:14rpx;flex:1;color:#173e38;font-size:28rpx;font-weight:600}.review-group-number{flex:none;color:#a17237;font-size:25rpx}.review-group-count{flex:none;color:#7b8883;font-size:23rpx}.review-group .issue{padding:22rpx 4rpx}.review-group .issue:last-child{border-bottom:0}
.review-group-toggle{display:flex;align-items:center;gap:14rpx}.review-group-chevron{display:inline-block;color:#a17237;font-size:32rpx;line-height:1;transition:transform .15s}.review-group-chevron.expanded{transform:rotate(90deg)}
.heading{box-sizing:border-box;align-items:center;margin:0 0 24rpx;padding:6rpx 0 22rpx;border-radius:0;border-bottom:1rpx solid #dce5df;background:transparent;box-shadow:none}.heading-copy{flex:1;min-width:0;border-left:5rpx solid #c99352;padding-left:18rpx}.heading-counter{color:#7b8883;font-size:22rpx;font-weight:400;letter-spacing:1rpx;line-height:1.5}.heading-title{margin-top:7rpx;color:#173e38;font-size:36rpx;font-weight:700;line-height:1.4}.heading-status{flex:none;padding:0;background:transparent;color:#7b8883;font-size:21rpx;line-height:1.5}
.focus-highlight{box-sizing:border-box;padding:20rpx;border:2rpx solid #c99352;border-radius:16rpx;background:#fff8ee;box-shadow:0 0 0 5rpx rgba(201,147,82,.12)}.focus-notice{color:#94672f;font-size:24rpx;font-weight:600;line-height:1.6;margin-bottom:14rpx;overflow-wrap:anywhere}.review-group .focus-notice{font-weight:400}
.review-navigation{gap:14rpx}.review-navigation button{font-size:26rpx;padding:20rpx 10rpx}.review-navigation .secondary{background:#eaf2ed;color:#173e38}.review-navigation .return-review{flex:1.35;background:#173e38;color:#fff}.review-navigation .secondary[disabled]{background:#eef2ef;color:#adb9b1}
.ai-check-context .focus-highlight{border-color:#4d8274;background:#edf6f1;box-shadow:0 0 0 5rpx rgba(77,130,116,.12)}.ai-check-context .focus-notice{color:#285d50}
.focus-marker{display:inline-flex;align-items:center;gap:18rpx;max-width:100%;box-sizing:border-box;padding:12rpx 18rpx;margin-bottom:18rpx;border-radius:12rpx;background:#8b612e;color:#fff;font-size:30rpx;font-weight:700;line-height:1.4;letter-spacing:1rpx}.focus-advice{font-size:26rpx;font-weight:500;line-height:1.65;color:#544737}.ai-check-context .focus-marker{background:#173e38}.ai-check-context .focus-advice{color:#285d50}
.review-group-count{display:inline-block;width:88rpx;text-align:left;white-space:nowrap;font-variant-numeric:tabular-nums}.review-group-alert{color:#b83c32;font-size:26rpx;font-weight:700}
.system-check-card .review-group-head{background:#fcf3e6}.review-section-head>button,.group-heading>button{margin-left:auto;margin-right:0;flex:none}
.optimize-button{margin:18rpx 0 4rpx;padding:12rpx 22rpx;font-size:26rpx}
