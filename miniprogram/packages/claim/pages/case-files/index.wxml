<home-nav id="claim-home-nav" title="本案文件"/><view class="shell"><view class="title">本案文件</view><view class="muted">已上传 {{count}} 个文件</view><view wx:if="{{!count}}" class="card empty">本案尚未上传文件。</view><view wx:for="{{groups}}" wx:key="title" class="card"><view class="section-title">{{item.title}}</view><view wx:for="{{item.files}}" wx:for-item="file" wx:key="id" class="file-row"><view class="file-detail" data-id="{{file.id}}" bindtap="open"><view>{{file.name}}</view><view class="muted">{{file.size}}</view></view><button size="mini" class="secondary" data-id="{{file.id}}" bindtap="open">查看</button><button size="mini" class="secondary" data-id="{{file.id}}" bindtap="share">转发</button></view></view></view>
