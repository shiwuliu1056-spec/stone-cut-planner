@import "../../claim.wxss";
.title{margin-bottom:28rpx}.document-name{font-size:30rpx;font-weight:600;line-height:1.6}progress{margin-top:24rpx}.primary{margin-top:24rpx}
.pdf-list{padding:8rpx 26rpx}.pdf-row{display:flex;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid #e8ede9}.pdf-row.last{border-bottom:0}.pdf-detail{flex:1;min-width:0}.pdf-name{font-size:27rpx;font-weight:600;line-height:1.5;color:#20332f;overflow-wrap:anywhere}.pdf-source{margin-top:10rpx}.pdf-source-badge{display:inline-block;color:#a17237;background:#fcf3e6;border-radius:6rpx;padding:3rpx 8rpx;font-size:20rpx;line-height:1.4}.pdf-source-name{margin-top:6rpx;font-size:21rpx;line-height:1.5;color:#7b8883}.pdf-row-actions{display:flex;align-items:center;gap:2rpx;flex:none}.pdf-row-actions .icon-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:72rpx;height:80rpx;margin:0;padding:14rpx;border-radius:16rpx;background:transparent;line-height:1}.pdf-row-actions .icon-button-active{background:#eef3ef}.action-icon{display:block;width:36rpx;height:36rpx;flex:none}
