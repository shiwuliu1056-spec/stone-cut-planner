.hero-card { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 36rpx 32rpx; border-radius: 28rpx; background: #173e38; color: #fff; box-shadow: 0 16rpx 36rpx rgba(23, 62, 56, 0.2); }
.eyebrow { margin-bottom: 12rpx; color: #d8b37a; font-size: 20rpx; letter-spacing: 3rpx; }
.hero-title { font-size: 42rpx; font-weight: 700; }
.hero-subtitle { margin-top: 10rpx; color: rgba(255, 255, 255, 0.68); font-size: 24rpx; }
.progress-float { position: fixed; left: 50%; bottom: 32rpx; bottom: calc(32rpx + constant(safe-area-inset-bottom)); bottom: calc(32rpx + env(safe-area-inset-bottom)); z-index: 100; display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; width: 390rpx; max-width: calc(100vw - 56rpx); padding: 14rpx 20rpx; border: 1rpx solid rgba(201, 147, 82, 0.34); border-radius: 20rpx; background: rgba(255, 250, 240, 0.97); box-shadow: 0 12rpx 34rpx rgba(23, 62, 56, 0.2); transform: translateX(-50%); }
.progress-ring { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; box-sizing: border-box; width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(201, 147, 82, 0.16); }
.progress-ring-inner { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; background: #fffaf0; color: var(--color-primary); }
.progress-number { align-self: center; font-size: 25rpx; font-weight: 700; line-height: 1; }
.progress-total { align-self: center; margin-top: 2rpx; color: var(--color-muted); font-size: 13rpx; line-height: 1; }
.progress-copy { flex: 1; }
.progress-title { margin-bottom: 4rpx; color: var(--color-primary); font-size: 26rpx; font-weight: 700; }
.section-title-actions, .item-heading, .limit-row, .algorithm-row, .picker-value, .preset-picker { display: flex; align-items: center; justify-content: space-between; }
.text-action, .delete-action { color: var(--color-muted); font-size: 23rpx; }
.text-action { margin-left: 18rpx; }
.delete-action { color: #b66c62; }
.item-card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 18rpx; background: #fbfaf7; }
.item-heading { margin-bottom: 20rpx; }
.item-label { color: var(--color-primary); font-size: 30rpx; font-weight: 700; }
.field-grid { display: grid; gap: 16rpx; }
.two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.field-label { display: block; margin-bottom: 10rpx; color: var(--color-muted); font-size: 22rpx; }
.number-field { display: flex; align-items: center; box-sizing: border-box; height: 74rpx; padding: 0 16rpx; border: 1rpx solid rgba(23, 62, 56, 0.13); border-radius: 12rpx; background: #fff; }
.number-field input { flex: 1; min-width: 0; color: var(--color-text); font-size: 30rpx; font-weight: 600; }
.number-field text { color: var(--color-muted); font-size: 21rpx; }
.number-field.compact { padding: 0 10rpx; }
.number-field.compact input { font-size: 25rpx; }
.limit-row { margin-top: 20rpx; }
.limit-row .field-label { margin: 0; }
.picker-value, .preset-picker { color: var(--color-primary); font-size: 25rpx; }
.add-row { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 18rpx 0 4rpx; color: var(--color-primary); font-size: 25rpx; font-weight: 600; }
.import-actions { display: flex; box-sizing: border-box; margin-top: 20rpx; overflow: hidden; border: 1rpx solid rgba(23, 62, 56, 0.2); border-radius: 14rpx; background: #fff; }
.secondary-action { display: flex; flex: 1; align-items: center; justify-content: center; gap: 8rpx; height: 76rpx; margin: 0; padding: 0; border: 0; border-radius: 0; background: #fff; color: var(--color-primary); font-size: 24rpx; line-height: 76rpx; }
.secondary-action + .secondary-action { border-left: 1rpx solid rgba(23, 62, 56, 0.14); }
.secondary-action[disabled] { opacity: 0.55; }
.summary-badge { color: var(--color-muted); font-size: 22rpx; font-weight: 400; }
.compact-section { padding-bottom: 24rpx; }
.algorithm-row { gap: 16rpx; }
.algorithm-option { flex: 1; box-sizing: border-box; padding: 22rpx; border: 1rpx solid rgba(23, 62, 56, 0.1); border-radius: 16rpx; background: #fbfaf7; }
.algorithm-option.active { border-color: var(--color-primary); background: #edf4f0; box-shadow: inset 0 0 0 1rpx var(--color-primary); }
.algorithm-name { margin-bottom: 8rpx; color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.preset-slot { visibility: hidden; box-sizing: border-box; height: 78rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(23, 62, 56, 0.08); }
.preset-slot.active { visibility: visible; }
.preset-picker { color: var(--color-primary); font-size: 25rpx; }
.primary-action { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
