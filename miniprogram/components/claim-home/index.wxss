.toolbox-return{display:inline-flex;margin-bottom:24rpx;padding:8rpx 0;color:#7b8883;font-size:25rpx}.return-pressed{opacity:.5}
.home-shell{min-height:100vh;background:#f7f5f0;color:#20332f;font-size:28rpx;box-sizing:border-box;padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}
.hero-card{display:flex;align-items:center;justify-content:space-between;gap:24rpx;background:#173e38;color:#fff;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 14rpx 28rpx rgba(23,62,56,.13)}
.hero-content{flex:1;min-width:0}
.eyebrow{color:#e3bc88;font-size:22rpx;letter-spacing:3rpx;line-height:1.5}
.hero-title{font-size:42rpx;font-weight:700;line-height:1.4;margin-top:12rpx}
.hero-subtitle{margin-top:12rpx;color:rgba(255,255,255,.68);font-size:24rpx;line-height:1.6}
.hero-document{box-sizing:border-box;position:relative;width:40rpx;height:50rpx;border:3rpx solid #c99352;border-radius:5rpx;flex:none}
.document-fold{position:absolute;right:-3rpx;top:-3rpx;width:12rpx;height:12rpx;border-left:3rpx solid #c99352;border-bottom:3rpx solid #c99352;background:#173e38}
.document-line{height:3rpx;background:#c99352;margin:21rpx 7rpx 0}
.document-line.short{margin-top:7rpx;width:13rpx}
.materials-card{background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 12rpx 28rpx rgba(23,62,56,.05)}
.materials-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx;color:#173e38;font-size:30rpx;font-weight:600}
.progress-label{color:#7b8883;font-size:22rpx;font-weight:400}
.material-row{display:flex;align-items:center;gap:16rpx;padding:25rpx 0;border-bottom:1rpx solid #edf0ec}
.material-row.last{border-bottom:0}
.material-number{color:#c99352;font-size:25rpx;font-weight:600;width:36rpx;flex:none}
.material-title{flex:1;font-size:28rpx;color:#20332f}
.material-arrow{color:#a17237;font-size:34rpx}
.material-percent{flex:none;min-width:56rpx;text-align:right;color:#7b8883;font-size:24rpx;font-variant-numeric:tabular-nums}
.home-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}
.home-action{width:100%;margin:0;box-sizing:border-box;border-radius:48rpx;padding:20rpx 8rpx;line-height:1.5;font-size:28rpx;font-weight:700}
.start-action{background:#173e38;color:#fff;box-shadow:0 8rpx 20rpx rgba(23,62,56,.12)}
.review-action{background:#c99352;color:#fff;box-shadow:0 8rpx 20rpx rgba(201,147,82,.12)}
.template-action,.sample-action{background:#173e38;color:#fff;border:0;box-shadow:0 8rpx 20rpx rgba(23,62,56,.12)}
.heading-name{display:flex;align-items:center;gap:12rpx}.heading-name .clear-small{box-sizing:border-box;flex:none;width:auto;height:30rpx;min-height:0;display:inline-flex;align-items:center;justify-content:center;margin:0;padding:0 10rpx;background:#f1f4f1;color:#7b8883;border-radius:8rpx;font-size:18rpx;font-weight:400;line-height:30rpx}

.home-action::after,.clear-small::after{border:0}
