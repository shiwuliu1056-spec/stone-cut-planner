.toolbox-home { box-sizing:border-box; min-height:100vh; background:#f7f5f0; color:#20332f; font-family:"PingFang SC","Microsoft YaHei",sans-serif; padding-bottom:calc(80rpx + env(safe-area-inset-bottom)); }
.toolbox-brand { position:relative; box-sizing:border-box; height:292rpx; padding:44rpx 46rpx 54rpx; overflow:hidden; border-radius:0 0 54rpx 0; background:#173e38; color:#fff; }
.toolbox-brand-copy { position:relative; z-index:1; }
.toolbox-kicker { font-size:19rpx; letter-spacing:4rpx; color:#d8b37a; }
.toolbox-title { margin:25rpx 0 15rpx; font-size:60rpx; line-height:1.3; letter-spacing:2rpx; font-weight:600; }
.toolbox-tagline { font-size:25rpx; letter-spacing:2rpx; color:rgba(255,255,255,.68); }
.toolbox-tagline-gap { margin-left:23rpx; }
.toolbox-brand-art { position:absolute; width:288rpx; height:288rpx; right:-35rpx; top:23rpx; }
.toolbox-directory { padding:48rpx 38rpx 0; }
.toolbox-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:33rpx; font-size:29rpx; font-weight:600; letter-spacing:1rpx; }
.toolbox-count { color:#7b8883; font-size:19rpx; letter-spacing:3rpx; font-weight:400; }
.toolbox-list { display:flex; flex-direction:column; gap:25rpx; }
.toolbox-card { box-sizing:border-box; display:grid; grid-template-columns:38rpx minmax(0,1fr) 154rpx; column-gap:23rpx; align-items:center; height:284rpx; padding:38rpx; border:1rpx solid rgba(23,62,56,.09); border-radius:36rpx; background:#fffefa; transition:transform .12s,background-color .12s; }
.toolbox-card-pressed { background:#edf2ec; border-color:rgba(23,62,56,.3); transform:scale(.985); }
.toolbox-number { align-self:start; padding-top:2rpx; color:#c99352; font-size:21rpx; line-height:29rpx; font-weight:500; letter-spacing:2rpx; }
.toolbox-copy { min-width:0; text-align:left; }
.toolbox-name { margin-bottom:15rpx; color:#173e38; font-size:42rpx; line-height:56rpx; font-weight:600; letter-spacing:1rpx; }
.toolbox-description { color:#69766f; font-size:23rpx; line-height:37rpx; }
.toolbox-scope { margin-top:13rpx; color:#887451; font-size:19rpx; line-height:27rpx; }
.toolbox-art { width:154rpx; height:138rpx; }
@media (max-width:380px) {
  .toolbox-directory { padding-left:35rpx; padding-right:35rpx; }
  .toolbox-card { padding-left:35rpx; padding-right:35rpx; grid-template-columns:35rpx minmax(0,1fr) 143rpx; column-gap:19rpx; }
  .toolbox-art { width:143rpx; height:131rpx; }
  .toolbox-description { font-size:22rpx; }
}
