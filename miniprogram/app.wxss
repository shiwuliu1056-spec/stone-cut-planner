page {
  --color-primary: #173e38;
  --color-accent: #c99352;
  --color-background: #f7f5f0;
  --color-card: #ffffff;
  --color-text: #20332f;
  --color-muted: #7b8883;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx 160rpx;
}

.section-card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(23, 62, 56, 0.08);
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 12rpx 32rpx rgba(23, 62, 56, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: var(--color-muted);
  font-size: 24rpx;
}

.demo-row {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fbfaf7;
}

.demo-row-title {
  margin-bottom: 8rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
}

.primary-action {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 12rpx 24rpx rgba(23, 62, 56, 0.18);
}

.accent-action {
  background: var(--color-accent);
  box-shadow: 0 12rpx 24rpx rgba(201, 147, 82, 0.2);
}

.ui-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-weight: 600;
  line-height: 1;
}

.hero-icon { color: #c99352; font-size: 64rpx; }
.check-icon { width: 52rpx; height: 52rpx; border-radius: 50%; background: #c99352; color: #fff; font-size: 34rpx; }
.info-icon { width: 32rpx; height: 32rpx; border: 2rpx solid currentColor; border-radius: 50%; font-size: 22rpx; }
.camera-icon, .file-icon { font-size: 34rpx; }
.add-icon { font-size: 34rpx; }
.arrow-icon, .download-icon { font-size: 36rpx; }
.chevron-icon { margin-left: 4rpx; font-size: 30rpx; }
.spec-tag { padding: 8rpx 14rpx; border-radius: 8rpx; background: #f0f4ff; color: #2455d6; font-size: 22rpx; font-weight: 600; }
